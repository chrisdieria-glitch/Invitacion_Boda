# Variables de entorno del backend Django.
# Cópialas tal cual en Render → tu servicio → Environment tab.
# (En desarrollo local usa backend/.env, que está en .gitignore.)

# Clave secreta de Django. NUNCA la subas al repositorio ni la expongas al frontend.
# Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Producción: False
DEBUG=False

# Host del backend en Render. Sin https:// y sin barra final.
ALLOWED_HOSTS=invitacion-boda-1-wt5o.onrender.com

# Origen del frontend en GitHub Pages. Sin barra final y sin la ruta /Invitacion_Boda/.
CORS_ALLOWED_ORIGINS=https://chrisdieria-glitch.github.io
CSRF_TRUSTED_ORIGINS=https://chrisdieria-glitch.github.io

# Usuario creado por build.sh en el primer deploy (opcional).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
